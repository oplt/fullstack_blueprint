# Local Compose settings. Coordinate port and credential changes with backend/.env.
# Set a distinct name and ports for each checkout if running several concurrently.
# COMPOSE_PROJECT_NAME=fullstack_blueprint
APP_ENV=dev
BACKEND_PORT=8000
JWT_SECRET=local-compose-secret-change-me-32-characters
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
POSTGRES_DB=fullstack_blueprint
POSTGRES_USER=fullstack_blueprint
POSTGRES_PASSWORD=fullstack_blueprint
POSTGRES_PORT=55432
REDIS_PORT=6380
# COMPOSE_PROFILES=mail,storage
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=blueprint-local
MINIO_ROOT_PASSWORD=blueprint-local-storage
