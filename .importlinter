[importlinter]
root_package = backend

[importlinter:contract:domain-independence]
name = Domain modules do not depend on API or infrastructure
type = forbidden
source_modules =
    backend.modules.memory.domain
    backend.modules.rag.domain
forbidden_modules =
    backend.api
    backend.core
    backend.db
    backend.modules.memory.infrastructure
    backend.modules.rag.infrastructure

[importlinter:contract:application-api-independence]
name = Application layers do not import their API layers
type = forbidden
source_modules =
    backend.modules.ai.application
    backend.modules.memory.application
    backend.modules.rag.application
forbidden_modules =
    backend.modules.memory.api
    backend.modules.rag.api

[importlinter:contract:event-domain-independence]
name = Event envelope does not depend on adapters
type = forbidden
source_modules =
    backend.modules.events.domain
forbidden_modules =
    backend.api
    backend.core
    backend.db
    backend.modules.memory.infrastructure
    backend.modules.rag.infrastructure
    backend.modules.events.models
    backend.modules.events.repository

[importlinter:contract:core-boundaries]
name = Core must not depend on feature modules
type = forbidden
source_modules =
    backend.core
forbidden_modules =
    backend.modules

[importlinter:contract:module-boundaries]
name = Business modules must not depend on API composition
type = forbidden
source_modules =
    backend.modules
forbidden_modules =
    backend.api
