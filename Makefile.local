VENV ?= $(CURDIR)/backend/.venv/bin
BACKEND_PORT ?= 8000
FRONTEND_PORT ?= 5173
COMPOSE := docker compose --project-directory . -f infra/docker-compose.yml $(if $(wildcard infra/.env),--env-file infra/.env)

export BACKEND_PORT FRONTEND_PORT
export BACKEND_PYTHON := $(VENV)/python

.PHONY: dev local-dev local-stop migrate db-migrate worker infra-up infra-down

local-stop:
	@echo "Releasing ports $(BACKEND_PORT) and $(FRONTEND_PORT)..."
	@fuser -k -TERM $(BACKEND_PORT)/tcp $(FRONTEND_PORT)/tcp 2>/dev/null || true
	@sleep 1
	@fuser -k -KILL $(BACKEND_PORT)/tcp $(FRONTEND_PORT)/tcp 2>/dev/null || true
	@echo "Checking development ports..."
	@if fuser $(BACKEND_PORT)/tcp $(FRONTEND_PORT)/tcp >/dev/null 2>&1; then \
		echo "Error: Development ports are still occupied."; \
		exit 1; \
	fi

dev local: local-stop
	@echo "Starting local development servers..."
	$(VENV)/honcho -f Procfile.dev start

migrate db-migrate:
	cd backend && $(VENV)/alembic upgrade head

worker:
	$(VENV)/python -m backend.workers.run_worker

infra-up:
	$(COMPOSE) up -d --wait

infra-down:
	$(COMPOSE) down