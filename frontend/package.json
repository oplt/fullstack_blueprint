{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pwa:check": "node scripts/check-pwa.mjs",
    "pwa:browser": "node scripts/check-pwa-browser.mjs",
    "perf:measure": "node scripts/measure-performance.mjs",
    "perf:check": "node scripts/check-bundle-size.mjs",
    "storybook": "STORYBOOK=1 storybook dev -p 6006",
    "storybook:build": "STORYBOOK=1 storybook build",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "design:check": "node scripts/check-design-system.mjs",
    "typecheck": "tsc -b",
    "audit": "npm audit --audit-level=high",
    "api:export": "cd .. && ${BACKEND_PYTHON:-backend/.venv/bin/python} backend/scripts/export_openapi.py --output frontend/src/lib/generated/openapi.json",
    "api:generate": "node scripts/generate-api-types.mjs",
    "api:generate:all": "npm run api:export && npm run api:generate",
    "api:check": "node scripts/check-api-contract.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "knip:production": "knip --production",
    "knip:files": "knip --files",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "knip:report": "knip --reporter json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fullcalendar/react": "^7.1.5",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.96.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^27.2.7",
    "lucide-react": "^1.79.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.72.0",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.11.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "temporal-polyfill": "^1.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "jsdom": "^26.1.0",
    "knip": "^6.48.0",
    "lighthouse": "^13.6.0",
    "msw": "^3.0.7",
    "msw-storybook-addon": "^3.0.3",
    "purgecss": "^9.1.0",
    "rollup-plugin-visualizer": "^7.3.0",
    "storybook": "^10.6.8",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "js-yaml": "5.5.0",
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "^14.0.3"
    },
    "workbox-build": {
      "glob": "^14.0.3"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
