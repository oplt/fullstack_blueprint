backend: set -eu; py="${BACKEND_PYTHON:-$PWD/backend/.venv/bin/python}"; port="${BACKEND_PORT:-8000}"; front="${FRONTEND_PORT:-5173}"; "$py" -c 'import sys; from backend.core.config import settings; ports=sys.argv[1:]; sys.exit("Use valid, distinct TCP ports") if any(not p.isascii() or not p.isdecimal() or p.startswith("0") or len(p)>5 or not 1<=int(p)<=65535 for p in ports) or int(ports[0])==int(ports[1]) else None; sys.exit("Refusing API startup outside development") if settings.APP_ENV.lower() not in {"dev","development","local"} else None' "$port" "$front"; export APP_PORT="$port" HEALTH_READY_PUBLIC=true; export FRONTEND_URL="${FRONTEND_URL:-http://127.0.0.1:$front}"; export CORS_ALLOWED_ORIGINS="${CORS_ALLOWED_ORIGINS:-http://localhost:$front,http://127.0.0.1:$front}"; set --; case "${BACKEND_RELOAD:-1}" in 1) set -- --reload --reload-dir backend --reload-exclude 'backend/.venv' --reload-exclude 'backend/logs' --reload-exclude 'logs';; 0) :;; *) echo 'BACKEND_RELOAD must be 0 or 1' >&2; exit 2;; esac; exec "$py" -m uvicorn backend.api.main:app --host 127.0.0.1 --port "$port" --no-proxy-headers "$@"
frontend: set -eu; port="${FRONTEND_PORT:-5173}"; backend_port="${BACKEND_PORT:-8000}"; for p in "$port" "$backend_port"; do case "$p" in ''|*[!0-9]*|0*) echo 'Use TCP ports in 1..65535, without leading zeros' >&2; exit 2;; esac; [ "${#p}" -le 5 ] && [ "$p" -le 65535 ] || { echo 'Use TCP ports in 1..65535' >&2; exit 2; }; done; [ "$port" != "$backend_port" ] || { echo 'Backend and frontend ports must differ' >&2; exit 2; }; export BACKEND_PROXY_TARGET="http://127.0.0.1:$backend_port"; timeout="${DEV_READY_TIMEOUT:-90}"; case "$timeout" in ''|*[!0-9]*|0*) echo 'DEV_READY_TIMEOUT must be an integer in 1..600' >&2; exit 2;; esac; [ "${#timeout}" -le 3 ] && [ "$timeout" -le 600 ] || { echo 'DEV_READY_TIMEOUT must be 1..600 seconds' >&2; exit 2; }; set --; case "${DEV_OPEN:-1}" in 1) set -- --open /;; 0) :;; *) echo 'DEV_OPEN must be 0 or 1' >&2; exit 2;; esac; echo "Waiting for backend readiness: $BACKEND_PROXY_TARGET/health/ready"; start=$(date +%s); while :; do remaining=$((timeout - ($(date +%s) - start))); [ "$remaining" -gt 0 ] || { echo 'Backend readiness timed out; inspect backend logs' >&2; exit 1; }; attempt=2; [ "$remaining" -ge 2 ] || attempt=$remaining; if code=$(curl --noproxy '*' -fsS --max-time "$attempt" -o /dev/null -w '%{http_code}' "$BACKEND_PROXY_TARGET/health/ready" 2>/dev/null); then case "$code" in 2[0-9][0-9]) break;; esac; fi; sleep .2; done; cd frontend; exec npm run dev -- --host 127.0.0.1 --port "$port" --strictPort "$@"
worker: set -eu; py="${BACKEND_PYTHON:-$PWD/backend/.venv/bin/python}"; "$py" -c 'import sys; from backend.core.config import settings; sys.exit("Refusing worker startup outside development") if settings.APP_ENV.lower() not in {"dev","development","local"} else None'; exec "$py" -m backend.workers.run_worker