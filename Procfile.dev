backend: exec "$BACKEND_PYTHON" -m uvicorn backend.api.main:app --reload --reload-dir backend --host 127.0.0.1 --port "$BACKEND_PORT" --no-proxy-headers
frontend: echo "Waiting for backend..." && timeout 60s sh -c 'until curl -fs --connect-timeout 1 --max-time 2 "http://127.0.0.1:$BACKEND_PORT/health/live" >/dev/null; do sleep 0.5; done' && cd frontend && BACKEND_PROXY_TARGET="http://127.0.0.1:$BACKEND_PORT" exec npm run dev -- --port "$FRONTEND_PORT" --strictPort --open
